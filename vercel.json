{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://cementapi-azhrhpgdexc0f0ck.southafricanorth-01.azurewebsites.net/api/$1" },
    { "source": "/sitemap.xml", "destination": "https://cementapi-azhrhpgdexc0f0ck.southafricanorth-01.azurewebsites.net/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://cementapi-azhrhpgdexc0f0ck.southafricanorth-01.azurewebsites.net/robots.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|svg|woff2|woff|ttf|eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}